# Copy to .env and fill in. Nothing here is required to run — with none of it,
# the app answers from stored text and speaks with the browser's own voice.
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local default is postgres://$USER@localhost:5432/voice_kb
# DATABASE_URL=postgres://shridharpathak@localhost:5432/voice_kb
#
# On Railway: do NOT paste a value here. Add a Postgres service and reference it
# from the app service as ${{Postgres.DATABASE_URL}} so it survives credential
# rotation. Railway does NOT set PORT for you — set it explicitly to match the
# domain's target port (8080).

# ---------------------------------------------------------------------------
# Gemini — powers both the answers and the voice
# ---------------------------------------------------------------------------
# One key does both. Without it: answers come from keyword retrieval over the
# stored text, and the browser speaks them. Everything still works.
# GEMINI_API_KEY=

# Answer generation. Strictly grounded — the model may rephrase what the
# knowledge base says, never add to it.
# GEMINI_MODEL=gemini-3.7-flash

# Voice. Gemini ships 30 prebuilt voices and documents none of their genders,
# only a manner. Run `node tools/voice-samples.js` to hear the candidates.
# Charon is "informative, clear"; Orus is "firm, decisive".
# GEMINI_TTS_VOICE=Charon

# Both TTS models are preview and could be renamed upstream — pinned here so
# that is a variable edit rather than an outage.
#   gemini-2.5-flash-preview-tts   fast, cheap
#   gemini-2.5-pro-preview-tts     higher fidelity, slower
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---------------------------------------------------------------------------
# ElevenLabs — kept for voice cloning
# ---------------------------------------------------------------------------
# Gemini's prebuilt voices cannot be made to sound like a specific person.
# When you want the agent in your own voice, clone it here and switch over:
#   TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Which engine speaks: gemini | elevenlabs | none.
# Unset, it picks whichever key is present, preferring Gemini.
# TTS_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Operator endpoints
# ---------------------------------------------------------------------------
# /api/gaps and /api/reload answer only to localhost until this is set. Set it
# on any deployed instance:
#   curl -H "Authorization: Bearer $ADMIN_TOKEN" https://your-app/api/gaps
# Generate one with: openssl rand -hex 32
# ADMIN_TOKEN=

# Signs the text that /api/speak is willing to synthesise, so a public URL is
# not an open proxy to a metered API. Falls back to ADMIN_TOKEN, then to a
# random value regenerated on every restart.
# SPEECH_SECRET=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# KB_CACHE_MS=30000     how long the in-memory knowledge base lives
# AUTO_SEED=0           skip provisioning an empty database from the JSON
# SKIP_MIGRATE=1        skip applying the schema at boot
# PORT=5178
